<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Taly records sound from your Mac so meeting recordings include other speakers.</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Taly</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Taly</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.karansinghgit.speaktype</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>speaktype</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>GitHubUpdatesRepository</key>
	<string>Ludvig-Hedin/speaktype</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<false/>
	<key>NSAppleEventsUsageDescription</key>
	<string>Taly needs permission to send keystrokes to paste transcribed text into the active application.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Taly only needs this if you transcribe an audio file stored on your Desktop.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Taly only needs this if you transcribe an audio file stored in your Documents folder. AI models are stored in the app's own Application Support folder.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Taly only needs this if you transcribe an audio file stored in your Downloads folder.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Taly needs access to your microphone to record your voice for transcription. All processing is done locally on your device.</string>
	<key>NSSupportsAutomaticTermination</key>
	<true/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
</dict>
</plist>
